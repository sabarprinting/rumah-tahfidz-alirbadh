    window.handleLogin = function(e) {
        e.preventDefault();
        const u = document.getElementById('loginUsername').value.trim();
        const p = document.getElementById('loginPassword').value.trim();
        const r = document.getElementById('loginRole').value;

        const found = appState.users.find(usr => usr.username === u && usr.password === p && usr.role === r && usr.status === 'Aktif');

        if (found) {
            currentUser = found;
            sessionStorage.setItem('rt_session', JSON.stringify(found));
            document.getElementById('login-view').classList.add('hidden');
            document.getElementById('public-website-view').classList.add('hidden');
            document.getElementById('publicNav').classList.add('hidden');
            document.getElementById('main-view').classList.remove('hidden');
            
