    // ABSENSI ONLINE PEMBINA LOGIC
    function renderAbsensiPembina() {
        const todayStr = new Date().toISOString().split('T')[0];
        const pId = currentUser && currentUser.pembinaId ? currentUser.pembinaId : 'PBN001';
        const pembinaObj = appState.pembina.find(p => p.id === pId) || appState.pembina[0];

        document.getElementById('clockInPembinaName').innerText = pembinaObj.nama;

        const todayLog = appState.absensiPembina.find(a => a.date === todayStr && a.pembinaId === pembinaObj.id);

        const btnIn = document.getElementById('btnClockIn');
        const btnOut = document.getElementById('btnClockOut');

        if (todayLog) {
            document.getElementById('todayJamMasuk').innerText = todayLog.jamMasuk || '-';
            document.getElementById('todayJamPulang').innerText = todayLog.jamPulang || '-';
            document.getElementById('todayStatusPembina').innerText = todayLog.status + ' (' + (todayLog.jamPulang !== '-' ? 'Selesai' : 'Sedang Bertugas') + ')';
            
            btnIn.disabled = true;
            btnOut.disabled = (todayLog.jamPulang !== '-');
        } else {
            document.getElementById('todayJamMasuk').innerText = '-';
            document.getElementById('todayJamPulang').innerText = '-';
            document.getElementById('todayStatusPembina').innerText = 'Belum Absen Masuk';
            
            btnIn.disabled = false;
            btnOut.disabled = true;
        }

        renderRekapPembinaTable();
    }

    window.handleClockIn = function() {
        const todayStr = new Date().toISOString().split('T')[0];
        const pId = currentUser && currentUser.pembinaId ? currentUser.pembinaId : 'PBN001';
        const pembinaObj = appState.pembina.find(p => p.id === pId) || appState.pembina[0];

        const nowStr = new Date().toLocaleTimeString('id-ID');

        const newLog = {
            id: 'ABSP' + Date.now(),
            date: todayStr,
            pembinaId: pembinaObj.id,
            nama: pembinaObj.nama,
            jamMasuk: nowStr,
            jamPulang: '-',
            status: 'Hadir',
            keterangan: 'Absen Masuk Online'
        };

        appState.absensiPembina.push(newLog);
        saveData();
        renderAbsensiPembina();
        showToast('Berhasil Absen Masuk jam ' + nowStr);
    }

    window.handleClockOut = function() {
        const todayStr = new Date().toISOString().split('T')[0];
        const pId = currentUser && currentUser.pembinaId ? currentUser.pembinaId : 'PBN001';
        const pembinaObj = appState.pembina.find(p => p.id === pId) || appState.pembina[0];

        const log = appState.absensiPembina.find(a => a.date === todayStr && a.pembinaId === pembinaObj.id);
        if (log) {
            const nowStr = new Date().toLocaleTimeString('id-ID');
            log.jamPulang = nowStr;
            log.keterangan = 'Absen Masuk & Pulang Lengkap';
            saveData();
            renderAbsensiPembina();
            showToast('Berhasil Absen Pulang jam ' + nowStr);
        }
    }

    function renderRekapPembinaTable() {
        const bulanFilter = document.getElementById('rekapPembinaBulan').value; // e.g. 2026-09
        const filteredLogs = appState.absensiPembina.filter(a => a.date.startsWith(bulanFilter));

        let totalHadir = 0, totalIzin = 0, totalAlpa = 0;
        
        const tbody = document.getElementById('rekapPembinaTableBody');
        tbody.innerHTML = appState.pembina.map(p => {
            const pLogs = filteredLogs.filter(l => l.pembinaId === p.id);
            const hadir = pLogs.filter(l => l.status === 'Hadir').length;
            const izin = pLogs.filter(l => l.status === 'Izin').length;
            const sakit = pLogs.filter(l => l.status === 'Sakit').length;
            const alpa = pLogs.filter(l => l.status === 'Alpa').length;

            totalHadir += hadir;
            totalIzin += (izin + sakit);
            totalAlpa += alpa;

            const percent = (hadir / 22 * 100).toFixed(0);

            return `
                <tr>
                    <td class="p-3.5 font-mono font-bold text-slate-700">${p.nip}</td>
                    <td class="p-3.5 font-semibold text-slate-800">${p.nama}</td>
                    <td class="p-3.5 text-center font-bold text-emerald-600">${hadir} Hari</td>
                    <td class="p-3.5 text-center font-medium text-amber-600">${izin}</td>
                    <td class="p-3.5 text-center font-medium text-indigo-600">${sakit}</td>
                    <td class="p-3.5 text-center font-medium text-rose-600">${alpa}</td>
                    <td class="p-3.5 text-center font-bold text-teal-700">${percent}%</td>
                </tr>
            `;
        }).join('');

        document.getElementById('rekapTotalHadir').innerText = totalHadir + ' Hari';
        document.getElementById('rekapTotalIzin').innerText = totalIzin + ' Hari';
        document.getElementById('rekapTotalAlpa').innerText = totalAlpa + ' Hari';
        document.getElementById('rekapTotalPembinaCount').innerText = appState.pembina.length + ' Orang';

        // Detail logs
        const detailTbody = document.getElementById('detailLogsPembinaTableBody');
        detailTbody.innerHTML = filteredLogs.map(l => `
            <tr>
                <td class="p-2.5 font-mono">${l.date}</td>
                <td class="p-2.5 font-semibold">${l.nama}</td>
                <td class="p-2.5 text-center font-bold text-emerald-600">${l.jamMasuk}</td>
                <td class="p-2.5 text-center font-bold text-amber-600">${l.jamPulang}</td>
                <td class="p-2.5 text-center"><span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold text-[10px]">${l.status}</span></td>
                <td class="p-2.5 text-slate-600">${l.keterangan || '-'}</td>
            </tr>
        `).join('');
    }

