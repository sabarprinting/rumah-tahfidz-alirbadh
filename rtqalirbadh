        document.getElementById('sppTotalTagihan').innerText = 'Rp ' + totalTagihan.toLocaleString('id-ID');
        document.getElementById('sppTotalLunas').innerText = 'Rp ' + totalLunas.toLocaleString('id-ID');
        document.getElementById('sppTotalTunggakan').innerText = 'Rp ' + totalTunggakan.toLocaleString('id-ID');

        renderSPPTable();
    }

    window.renderSPPTable = function() {
        const tbody = document.getElementById('sppTableBody');
        tbody.innerHTML = appState.spp.map(s => {
            const st = appState.santri.find(x => x.nis === s.nis) || { nama: 'Santri' };
            return `
                <tr>
                    <td class="p-3.5 font-mono text-xs">${s.nis}</td>
                    <td class="p-3.5 font-bold text-slate-800">${st.nama}</td>
                    <td class="p-3.5 font-semibold text-slate-600">${s.bulan}</td>
                    <td class="p-3.5 font-bold text-slate-800">Rp ${s.nominal.toLocaleString('id-ID')}</td>
                    <td class="p-3.5"><span class="px-2.5 py-1 ${s.status === 'Lunas' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'} text-xs font-bold rounded-full">${s.status}</span></td>
                    <td class="p-3.5 font-mono text-xs text-slate-500">${s.kuitansi}</td>
                    <td class="p-3.5 text-center">
                        <button onclick="window.toggleSPPStatus('${s.id}')" class="px-3 py-1 bg-teal-600 hover:bg-teal-700 text-white rounded text-xs font-bold transition">Ubah Status</button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    window.toggleSPPStatus = function(id) {
        const item = appState.spp.find(s => s.id === id);
        if (item) {
            item.status = item.status === 'Lunas' ? 'Belum Lunas' : 'Lunas';
            item.kuitansi = item.status === 'Lunas' ? 'KWT-' + Date.now().toString().slice(-6) : '-';
            saveData();
            renderKeuangan();
            showToast('Status pembayaran SPP diperbarui!');
        }
    }

    // KAS MANAGEMENT
    function renderKas() {
        const masuk = appState.kas.filter(k => k.jenis === 'Pemasukan').reduce((a, c) => a + c.nominal, 0);
        const keluar = appState.kas.filter(k => k.jenis === 'Pengeluaran').reduce((a, c) => a + c.nominal, 0);
        const saldo = masuk - keluar;

        document.getElementById('kasTotalMasuk').innerText = 'Rp ' + masuk.toLocaleString('id-ID');
        document.getElementById('kasTotalKeluar').innerText = 'Rp ' + keluar.toLocaleString('id-ID');
        document.getElementById('kasSaldo').innerText = 'Rp ' + saldo.toLocaleString('id-ID');

        renderKasTable();
    }

    window.renderKasTable = function() {
        const filter = document.getElementById('filterJenisKas').value;
        const list = filter ? appState.kas.filter(k => k.jenis === filter) : appState.kas;
        const tbody = document.getElementById('kasTableBody');

        tbody.innerHTML = list.map(k => `
            <tr>
                <td class="p-3.5 font-mono text-xs">${k.tanggal}</td>
                <td class="p-3.5"><span class="px-2 py-0.5 ${k.jenis === 'Pemasukan' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'} text-xs font-bold rounded">${k.jenis}</span></td>
                <td class="p-3.5 font-semibold text-slate-700">${k.kategori}</td>
                <td class="p-3.5 text-slate-600">${k.keterangan}</td>
                <td class="p-3.5 font-bold ${k.jenis === 'Pemasukan' ? 'text-emerald-700' : 'text-rose-700'}">Rp ${k.nominal.toLocaleString('id-ID')}</td>
                <td class="p-3.5 text-center">
                    <button onclick="window.deleteKas('${k.id}')" class="text-rose-600 hover:text-rose-800 font-bold"><i class="fa-solid fa-trash"></i></button>
                </td>
            </tr>
        `).join('');
    }

    window.openModalKas = function(jenis) {
        document.getElementById('kasJenis').value = jenis;
        document.getElementById('kasTanggal').value = new Date().toISOString().split('T')[0];
        document.getElementById('modalKas').classList.remove('hidden');
    }
    window.closeModalKas = function() { document.getElementById('modalKas').classList.add('hidden'); }
    window.saveKas = function(e) {
        e.preventDefault();
        const newK = {
            id: 'KAS' + Date.now(),
            jenis: document.getElementById('kasJenis').value,
            kategori: document.getElementById('kasKategori').value,
            keterangan: document.getElementById('kasKeterangan').value,
            nominal: parseInt(document.getElementById('kasNominal').value) || 0,
            tanggal: document.getElementById('kasTanggal').value
        };
        appState.kas.unshift(newK);
        saveData();
        closeModalKas();
        renderKas();
        showToast('Transaksi Kas berhasil disimpan!');
    }
    window.deleteKas = function(id) {
        if (confirm('Hapus transaksi ini?')) {
            appState.kas = appState.kas.filter(k => k.id !== id);
            saveData();
            renderKas();
            showToast('Transaksi terhapus.');
        }
    }

    // RAPOR PREVIEW
    function renderRaporPreview() {
        const sel = document.getElementById('raporSantriSelect');
        sel.innerHTML = appState.santri.map(s => `<option value="${s.nis}">${s.nama} (${s.halaqoh})</option>`).join('');

        const selectedNis = sel.value || (appState.santri[0] ? appState.santri[0].nis : '');
        const santriObj = appState.santri.find(s => s.nis === selectedNis);

        if (!santriObj) return;

        document.getElementById('raporNama').innerText = santriObj.nama;
        document.getElementById('raporNIS').innerText = santriObj.nis;
        document.getElementById('raporHalaqoh').innerText = santriObj.halaqoh;
        document.getElementById('raporTotalJuz').innerText = santriObj.juz + ' Juz';

        const hal = appState.halaqoh.find(h => h.nama === santriObj.halaqoh);
        const musyrifName = hal ? hal.musyrif : 'Ustadz Pembimbing';
        document.getElementById('raporMusyrif').innerText = musyrifName;
        document.getElementById('raporMusyrifTTD').innerText = musyrifName;

        const santriSetoran = appState.setoran.filter(s => s.nis === selectedNis);
        const detailTbody = document.getElementById('raporDetailSetoranTableBody');

        detailTbody.innerHTML = santriSetoran.slice(0, 5).map(s => `
            <tr>
                <td class="border border-slate-300 p-2 text-center font-mono">${s.tanggal}</td>
                <td class="border border-slate-300 p-2 font-semibold">${s.jenis}</td>
                <td class="border border-slate-300 p-2">${s.surah} (${s.ayat})</td>
                <td class="border border-slate-300 p-2 text-center font-bold text-teal-800">Tajwid: ${s.tajwid} | Kelancaran: ${s.kelancaran}</td>
            </tr>
        `).join('');
    }

    // PENDAFTARAN ADMIN & PUBLIC
    function renderPendaftaranAdmin() {
        const tbody = document.getElementById('pendaftaranTableBody');
        if (appState.pendaftaran.length === 0) {
            tbody.innerHTML = '<tr><td colspan="8" class="p-4 text-center text-slate-400">Belum ada pendaftaran masuk.</td></tr>';
            return;
        }
        tbody.innerHTML = appState.pendaftaran.map(p => `
            <tr>
                <td class="p-3.5 font-mono text-xs">${p.id}</td>
                <td class="p-3.5 text-xs">${p.tanggal}</td>
                <td class="p-3.5 font-bold text-slate-800">${p.nama}</td>
                <td class="p-3.5 text-xs">${p.gender}</td>
                <td class="p-3.5 text-xs">${p.ortu}</td>
                <td class="p-3.5 font-mono text-xs text-teal-700">${p.wa}</td>
                <td class="p-3.5"><span class="px-2 py-0.5 bg-amber-100 text-amber-800 font-bold text-xs rounded">${p.status}</span></td>
                <td class="p-3.5 text-center">
                    <button onclick="window.terimaSantri('${p.id}')" class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded text-xs font-bold">Terima Santri</button>
                </td>
            </tr>
        `).join('');
    }

    window.handlePublicRegister = function(e) {
        e.preventDefault();
        const newReg = {
            id: 'REG' + Date.now().toString().slice(-5),
            tanggal: new Date().toISOString().split('T')[0],
            nama: document.getElementById('regNama').value,
            gender: document.getElementById('regGender').value,
            ortu: document.getElementById('regOrtu').value,
            wa: document.getElementById('regWA').value,
            alamat: document.getElementById('regAlamat').value,
            status: 'Menunggu'
        };

        appState.pendaftaran.push(newReg);
        saveData();
        document.getElementById('publicRegisterForm').reset();
        alert('Alhamdulillah! Pendaftaran calon santri baru berhasil dikirim. Tim admin akan menghubungi Anda via WhatsApp.');
    }

    window.terimaSantri = function(id) {
        const reg = appState.pendaftaran.find(p => p.id === id);
        if (reg) {
            const newSantri = {
                nis: 'STR2026' + (appState.santri.length + 1).toString().padStart(3, '0'),
                nama: reg.nama,
                halaqoh: 'Halaqoh Abu Bakar',
                ortu: reg.ortu,
                wa: reg.wa,
                juz: 0,
                status: 'Aktif',
                spp: appState.settings.sppDefault
            };
            appState.santri.push(newSantri);
            reg.status = 'Diterima';
            saveData();
            renderPendaftaranAdmin();
            showToast('Calon santri diterima & masuk ke Data Santri!');
        }
    }

    // WA TRIGGER GENERATOR
    function updateWAPreview() {
        const selS = document.getElementById('waSantriSelect');
        selS.innerHTML = appState.santri.map(s => `<option value="${s.nis}">${s.nama} (${s.ortu})</option>`).join('');

        const selectedNis = selS.value || (appState.santri[0] ? appState.santri[0].nis : '');
        const st = appState.santri.find(s => s.nis === selectedNis);
        const type = document.getElementById('waTypeSelect').value;

        let msg = '';
        if (type === 'setoran') {
            msg = `*Laporan Setoran Hafalan Santri*\nLembaga: ${appState.settings.namaLembaga}\n\nAssalamu'alaikum Bpk/Ibu ${st ? st.ortu : ''},\nBerikut perkembangan setoran hafalan ananda *${st ? st.nama : ''}*:\n- Total Hafalan: ${st ? st.juz : 0} Juz\n- Status: Sangat Baik & Mutqin\n\nSyukron, Wassalamu'alaikum.`;
        } else {
            msg = `*Pengingat SPP Bulanan*\nLembaga: ${appState.settings.namaLembaga}\n\nAssalamu'alaikum Bpk/Ibu ${st ? st.ortu : ''},\nMemberitahukan tagihan SPP ananda *${st ? st.nama : ''}* bulan ini sebesar Rp ${st ? st.spp.toLocaleString('id-ID') : 0}.\n\nTerima kasih atas perhatiannya.`;
        }
        document.getElementById('waPreviewText').value = msg;
    }

    window.sendWATrigger = function() {
        const nis = document.getElementById('waSantriSelect').value;
        const st = appState.santri.find(s => s.nis === nis);
        const text = encodeURIComponent(document.getElementById('waPreviewText').value);
        const waNum = st ? st.wa : appState.settings.wa;
        window.open(`https://wa.me/${waNum}?text=${text}`, '_blank');
    }

    // SETTINGS FORM
    function loadSettingsForm() {
        document.getElementById('settingsNamaLembaga').value = appState.settings.namaLembaga;
        document.getElementById('settingsMudir').value = appState.settings.mudir;
        document.getElementById('settingsWA').value = appState.settings.wa;
        document.getElementById('settingsSPPDefault').value = appState.settings.sppDefault;
        document.getElementById('settingsAlamat').value = appState.settings.alamat;
    }

    window.saveSettings = function(e) {
        e.preventDefault();
        appState.settings.namaLembaga = document.getElementById('settingsNamaLembaga').value;
        appState.settings.mudir = document.getElementById('settingsMudir').value;
        appState.settings.wa = document.getElementById('settingsWA').value;
        appState.settings.sppDefault = parseInt(document.getElementById('settingsSPPDefault').value) || 350000;
        appState.settings.alamat = document.getElementById('settingsAlamat').value;

        saveData();
        showToast('Pengaturan lembaga berhasil diperbarui!');
    }

    window.resetDataToDefault = function() {
        if (confirm('Apakah Anda yakin ingin mengembalikan seluruh data ke kondisi awal (default)? Semua perubahan akan terhapus.')) {
            localStorage.removeItem(STORAGE_KEY);
            appState = DEFAULT_STATE;
            saveData();
            location.reload();
        }
    }

    window.syncDataBackend = function() {
        saveData();
        showToast('Data berhasil disinkronisasi ke penyimpanan lokal.');
    }

    // INIT CLOCK & SYSTEM
    setInterval(() => {
        const now = new Date();
        const str = now.toLocaleTimeString('id-ID') + ' WITA';
        const liveClockEl = document.getElementById('liveClock');
        if (liveClockEl) liveClockEl.innerText = str;

        const rtClock = document.getElementById('absensiRealtimeClock');
        if (rtClock) rtClock.innerText = str;
    }, 1000);

    // INITIAL LOAD
    window.addEventListener('DOMContentLoaded', () => {
        renderPublicWeb();

        if (currentUser) {
            document.getElementById('public-website-view').classList.add('hidden');
            document.getElementById('publicNav').classList.add('hidden');
            document.getElementById('main-view').classList.remove('hidden');
            applyUserRoleUI();
            switchTab('dashboard');
        } else {
            showPublicLanding();
        }
    });
</script>
